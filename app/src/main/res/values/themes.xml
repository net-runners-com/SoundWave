<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Jetpack Compose -->
    <style name="Theme.SoundWave" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="android:colorPrimary">@color/purple_500</item>
        <item name="android:colorPrimaryDark">@color/purple_700</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/purple_700</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.SoundWave.NoActionBar" parent="Theme.SoundWave">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.SoundWave.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.SoundWave.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>